    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "enum": [
            "task_response",
            "organization",
            "grammar",
            "vocabulary",
            "intelligibility",
            "fluency",
            "interaction"
          ]
        },
        "status": {
          "enum": [
            "scored",
            "not_assessable",
            "not_applicable"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_mode": {
          "enum": [
            "text",
            "archived_audio",
            "live_audio",
            "event",
            "none"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "missing_audio",
                "missing_card",
                "missing_question",
                "missing_transcript",
                "insufficient_sample",
                "technical_failure",
                "unsupported_modality",
                "not_in_scope",
                "uncertain_evidence"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "criterion_id",
        "status",
        "score",
        "evidence_mode",
        "evidence_refs",
        "reason_code",
        "reason",
        "confidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "scored"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "evidence_refs": {
                "minItems": 1
              },
              "reason_code": {
                "type": "null"
              },
              "evidence_mode": {
                "enum": [
                  "text",
                  "archived_audio",
                  "live_audio",
                  "event"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_assessable",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
